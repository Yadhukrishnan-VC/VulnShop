FROM python:3.11-slim

WORKDIR /scanner

RUN pip install --no-cache-dir \
    flask==3.0.0 \
    requests==2.31.0 \
    PyJWT==2.8.0 \
    reportlab==4.0.7 \
    urllib3==2.1.0 \
    gunicorn==21.2.0

COPY . .

RUN mkdir -p /reports

EXPOSE 9000

# 🔥 THIS IS CRITICAL
CMD ["gunicorn", "-b", "0.0.0.0:9000", "app:app"]